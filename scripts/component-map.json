{
  "_comment": "Path prefix -> node IDs in blast-radius.html. First matching prefix wins; longest prefixes listed first. 'arch' = ARCH_NODES id, 'mod' = MOD_NODES id (only for gateway/Fastify internals).",
  "rules": [
    { "prefix": "demo-repo/api-gateway/router",     "arch": "gateway", "mod": "routing" },
    { "prefix": "demo-repo/api-gateway/",           "arch": "gateway", "mod": "core" },
    { "prefix": "demo-repo/auth-service/",          "arch": "auth" },
    { "prefix": "demo-repo/user-service/",          "arch": "user" },
    { "prefix": "demo-repo/product-service/",       "arch": "product" },
    { "prefix": "demo-repo/order-service/",         "arch": "order" },
    { "prefix": "demo-repo/payment-service/",       "arch": "stripe" },
    { "prefix": "demo-repo/notification-service/",  "arch": "notif" },
    { "prefix": "demo-repo/event-bus/",             "arch": "queue" },
    { "prefix": "demo-repo/cache/",                 "arch": "redis" },
    { "prefix": "demo-repo/session-store/",         "arch": "redis" },
    { "prefix": "demo-repo/rate-limiter/",          "arch": "redis" },
    { "prefix": "demo-repo/database/",              "arch": "postgres" },
    { "prefix": "demo-repo/storage/",               "arch": "s3" },
    { "prefix": "demo-repo/logger/",                "arch": "gateway", "mod": "logging" },

    { "prefix": "fastify/lib/route",                "arch": "gateway", "mod": "routing" },
    { "prefix": "fastify/lib/four-oh-four",         "arch": "gateway", "mod": "routing" },
    { "prefix": "fastify/lib/handle-request",       "arch": "gateway", "mod": "routing" },
    { "prefix": "fastify/lib/plugin",               "arch": "gateway", "mod": "plugins" },
    { "prefix": "fastify/lib/decorate",             "arch": "gateway", "mod": "plugins" },
    { "prefix": "fastify/lib/server",               "arch": "gateway", "mod": "server" },
    { "prefix": "fastify/lib/hooks",                "arch": "gateway", "mod": "server" },
    { "prefix": "fastify/lib/request",              "arch": "gateway", "mod": "reqres" },
    { "prefix": "fastify/lib/reply",                "arch": "gateway", "mod": "reqres" },
    { "prefix": "fastify/lib/content-type",         "arch": "gateway", "mod": "reqres" },
    { "prefix": "fastify/lib/schema",               "arch": "gateway", "mod": "validation" },
    { "prefix": "fastify/lib/validation",           "arch": "gateway", "mod": "validation" },
    { "prefix": "fastify/lib/config-validator",     "arch": "gateway", "mod": "validation" },
    { "prefix": "fastify/lib/initial-config",       "arch": "gateway", "mod": "validation" },
    { "prefix": "fastify/lib/error",                "arch": "gateway", "mod": "errors" },
    { "prefix": "fastify/lib/logger",               "arch": "gateway", "mod": "logging" },
    { "prefix": "fastify/lib/",                     "arch": "gateway", "mod": "internals" },
    { "prefix": "fastify/fastify.js",               "arch": "gateway", "mod": "core" }
  ]
}
